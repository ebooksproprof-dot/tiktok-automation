    {
      "key": "68c8823c1a6d6d03c5516bf7c83e36c4911fc4cb0ffc59412de162a5aaa1df35",
      "text": "Deixe espaço entre as peças, sem equilibrar uma sobre a outra.",
      "sha256": "f05af6f7c0fecbd55bfd1a0ec8d8f5bc613078cae197fccecd39a48d76e35815",
      "inference_seconds": 57.05687628600026
    },
    {
      "key": "459a232a8421c4491debf805dc40eb48e8529c1c0a88b5f4b5cc28c4a8d11ef4",
      "text": "Observe a borda e o fundo. Se houver gotas, espere secar completamente.",
