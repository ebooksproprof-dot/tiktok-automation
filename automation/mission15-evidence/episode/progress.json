    {
      "key": "d8ace31257cff96f8f1a25fb24d97398a4ded733e5220af1ea3ddbf43c3164a0",
      "text": "Depois de lavar, apoie cada copo em um escorredor adequado ao material.",
      "sha256": "41829686697a4ce4453096ad822e553736d1cba26c77e0f75fdbb4745eb9eb3b",
